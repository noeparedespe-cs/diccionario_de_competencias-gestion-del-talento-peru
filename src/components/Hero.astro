---
import { Image } from 'astro:assets';
import botella2d from '../assets/botella2d.png';
import crecerLogo from '../assets/crecer-logo-sinfondo.png';
import radarLogo from '../assets/radar-de-talento-logo-sinfondo.png';
---

<section id="inicio" class="noise relative min-h-[100svh] overflow-hidden bg-black pt-24">
  <div class="grid-lines pointer-events-none absolute inset-0 opacity-50"></div>

    <div class="pointer-events-none absolute -left-[20rem] top-1/2 size-[42rem] -translate-y-1/2 opacity-[0.55]" aria-hidden="true">
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-yellow/70"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-yellow/60"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-yellow/60 [animation-delay:0.8s]"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-yellow/60 [animation-delay:1.6s]"></span>
    <div class="orbit-spin absolute inset-0">
      {[0, 60, 120, 180, 240, 300].map((deg, i) => (
        <span
          class="orbit-dot absolute left-1/2 top-1/2 rounded-full bg-brand-yellow shadow-[0_0_16px_4px_rgba(246,198,18,0.65)]"
          style={`width:${i % 2 === 0 ? '0.85rem' : '0.5rem'};height:${i % 2 === 0 ? '0.85rem' : '0.5rem'};transform: rotate(${deg}deg) translateX(${16 + (i % 3) * 4}rem);`}
        />
      ))}
    </div>
  </div>
    <div class="pointer-events-none absolute -right-[20rem] top-1/2 size-[38rem] -translate-y-1/2 opacity-[0.55]" aria-hidden="true">
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-red/70"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-red/60 [animation-delay:0.4s]"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-red/60 [animation-delay:1.2s]"></span>
    <div class="orbit-spin-reverse absolute inset-0">
      {[30, 90, 150, 210, 270, 330].map((deg, i) => (
        <span
          class="orbit-dot absolute left-1/2 top-1/2 rounded-full bg-brand-red shadow-[0_0_16px_4px_rgba(198,24,24,0.6)]"
          style={`width:${i % 2 === 0 ? '0.75rem' : '0.45rem'};height:${i % 2 === 0 ? '0.75rem' : '0.45rem'};transform: rotate(${deg}deg) translateX(${14 + (i % 3) * 4}rem);`}
        />
      ))}
    </div>
  </div>

    <div class="pointer-events-none absolute -left-16 bottom-[12%] size-96 rounded-full bg-brand-yellow/20 blur-[110px] animate-float-slower" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-20 top-[15%] size-96 rounded-full bg-brand-red/15 blur-[110px] animate-float-slow" aria-hidden="true"></div>

    <div class="pointer-events-none absolute left-4 top-1/2 hidden w-[16.9rem] -translate-y-1/2 animate-float-slower sm:block lg:left-10 lg:w-[20.8rem]" aria-hidden="true">
    <Image src={radarLogo} alt="Radar de Talento" width={560} height={155} class="h-auto w-full object-contain brightness-0 invert drop-shadow-lg" />
  </div>
    <div class="pointer-events-none absolute right-4 top-1/2 hidden w-60 -translate-y-1/2 animate-float-slow sm:block lg:right-10 lg:w-80" aria-hidden="true">
    <Image src={crecerLogo} alt="CRECER" width={560} height={219} class="h-auto w-full object-contain brightness-0 invert drop-shadow-lg" />
  </div>

    <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-2 pb-16 sm:gap-4 sm:pb-20 lg:pb-28" aria-hidden="true">
    <p class="text-outline font-wordmark m-0 select-none whitespace-nowrap text-center text-[min(26vh,28vw)] leading-none sm:text-[min(32vh,22vw)] lg:text-[min(36vh,16vw)]">
      B<span id="hero-i-letter" class="inline-block text-transparent [-webkit-text-stroke:0]">I</span>G
    </p>
    <p class="text-shine-warm font-wordmark m-0 select-none whitespace-nowrap text-center text-[min(26vh,13vw)] leading-none sm:text-[min(32vh,10vw)] lg:text-[min(36vh,8vw)]">
      TALENT
    </p>
  </div>

    <div id="hero-bottle-slot" class="pointer-events-none absolute z-10">
    <Image
      src={botella2d}
      alt="Botella BIG Cola"
      width={520}
      height={780}
      class="h-full w-full object-contain"
      loading="eager"
    />
  </div>

  <div class="relative mx-auto flex h-[calc(100svh-6rem)] max-w-7xl flex-col justify-end px-5 pb-10 sm:px-8">
    <div class="relative z-10 flex flex-col items-center gap-5 text-center">
      <p class="reveal font-display max-w-lg text-lg font-medium text-white/70 sm:text-xl">
        Grandes Marcas, <span class="font-bold text-white">Grandes Talentos</span>
      </p>
      <p class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-white/40">Gestión del Talento Perú</p>

      <div class="reveal grid w-full max-w-xl gap-3 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/14 bg-white/[0.06] p-4 text-left backdrop-blur-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-red">Alcance</p>
          <p class="mt-1 text-sm text-white/70">Niveles N1 y N2 evaluados en Crecer y Radar de Talento</p>
        </div>
        <div class="rounded-2xl border border-white/14 bg-white/[0.06] p-4 text-left backdrop-blur-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-red">Uso</p>
          <p class="mt-1 text-sm text-white/70">Base para evaluación, feedback y desarrollo</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes orbit-spin-reverse {
    to {
      transform: rotate(-360deg);
    }
  }
  .orbit-spin {
    animation: orbit-spin 22s linear infinite;
  }
  .orbit-spin-reverse {
    animation: orbit-spin-reverse 18s linear infinite;
  }
  .orbit-dot {
    margin: 0;
    transform-origin: 0 0;
  }
  #hero-bottle-slot {
    left: 50%;
    top: 44%;
    transform: translate(-50%, -50%);
    width: clamp(4rem, 8vw, 10rem);
    height: clamp(6rem, 12vw, 15rem);
  }
</style>

<script>
  // Tamaño de la botella 2D respecto al espacio original.
  const ESCALA_BOTELLA = 1.5;

  const section = document.querySelector<HTMLElement>('#inicio');
  const iLetter = document.querySelector<HTMLElement>('#hero-i-letter');
  const slot = document.querySelector<HTMLElement>('#hero-bottle-slot');

  const positionBottle = () => {
    if (!section || !iLetter || !slot) return;
    const sectionRect = section.getBoundingClientRect();
    const iRect = iLetter.getBoundingClientRect();
    const width = Math.max(iRect.width, 64) * ESCALA_BOTELLA;
    const height = iRect.height * ESCALA_BOTELLA;
    const centerX = iRect.left + iRect.width / 2;
    const centerY = iRect.top + iRect.height / 2;
    slot.style.transform = 'none';
    slot.style.left = `${centerX - width / 2 - sectionRect.left}px`;
    slot.style.top = `${centerY - height / 2 - sectionRect.top}px`;
    slot.style.width = `${width}px`;
    slot.style.height = `${height}px`;
  };

  positionBottle();
  document.fonts?.ready.then(positionBottle);
  window.addEventListener('resize', positionBottle);
</script>
