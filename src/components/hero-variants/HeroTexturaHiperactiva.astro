---
import { Image } from 'astro:assets';
import botella2d from '../../assets/botella2d.png';
import ThemeToggleButton from './ThemeToggleButton.astro';

const microLabels = ['N1', 'N2', 'CRECER', 'RADAR DE TALENTO', 'FEEDBACK', 'DESARROLLO'];
const topParticles = Array.from({ length: 18 }, (_, i) => i);
const bottomParticles = Array.from({ length: 18 }, (_, i) => i);
---

<section id="inicio-textura-5" class="theme noise relative min-h-[100svh] overflow-hidden pt-24" data-theme="dark">
  <ThemeToggleButton />
  <div class="t-grid-lines pointer-events-none absolute inset-0 opacity-100"></div>
  <div class="pointer-events-none absolute inset-0 breathing-glow"></div>

    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-40" aria-hidden="true">
    <div class="mega-sweep absolute -inset-[40%]" style="background: conic-gradient(from 0deg, transparent, rgba(198,24,24,0.25) 8deg, transparent 20deg, transparent 180deg, rgba(246,198,18,0.22) 190deg, transparent 205deg);"></div>
  </div>

  <div id="parallax-layer-5" class="pointer-events-none absolute inset-0">
        <div class="absolute -left-[19rem] top-1/2 size-[40rem] -translate-y-1/2 opacity-[0.55]" aria-hidden="true">
      <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-red/70"></span>
      <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-red/60"></span>
      <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-red/60 [animation-delay:0.5s]"></span>
      <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-red/60 [animation-delay:1s]"></span>
      <div class="orbit-spin-fast absolute inset-0">
        {[0, 45, 90, 135, 180, 225, 270, 315].map((deg, i) => (
          <span
            class="rounded-full bg-brand-red shadow-[0_0_16px_4px_rgba(198,24,24,0.6)]"
            style={`position:absolute;left:50%;top:50%;width:${i % 2 === 0 ? '0.8rem' : '0.4rem'};height:${i % 2 === 0 ? '0.8rem' : '0.4rem'};transform: rotate(${deg}deg) translateX(${14 + (i % 3) * 3}rem);`}
          />
        ))}
      </div>
    </div>
        <div class="absolute -right-[19rem] top-1/2 size-[36rem] -translate-y-1/2 opacity-[0.55]" aria-hidden="true">
      <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-yellow/70"></span>
      <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-yellow/60 [animation-delay:0.3s]"></span>
      <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-yellow/60 [animation-delay:0.9s]"></span>
      <div class="orbit-spin-fast-reverse absolute inset-0">
        {[20, 65, 110, 155, 200, 245, 290, 335].map((deg, i) => (
          <span
            class="rounded-full bg-brand-yellow shadow-[0_0_16px_4px_rgba(246,198,18,0.6)]"
            style={`position:absolute;left:50%;top:50%;width:${i % 2 === 0 ? '0.7rem' : '0.4rem'};height:${i % 2 === 0 ? '0.7rem' : '0.4rem'};transform: rotate(${deg}deg) translateX(${13 + (i % 3) * 3}rem);`}
          />
        ))}
      </div>
    </div>

        <div class="absolute -left-10 -top-10 size-52 opacity-40" aria-hidden="true">
      <div class="hex-spin hex-pulse absolute inset-0 border-2 border-brand-yellow/50" style="clip-path: polygon(25% 3%, 75% 3%, 100% 50%, 75% 97%, 25% 97%, 0% 50%);"></div>
    </div>
    <div class="absolute -right-10 -top-10 size-52 opacity-40" aria-hidden="true">
      <div class="hex-spin-reverse hex-pulse absolute inset-0 border-2 border-brand-red/50" style="clip-path: polygon(25% 3%, 75% 3%, 100% 50%, 75% 97%, 25% 97%, 0% 50%);"></div>
    </div>
  </div>

    <div class="pointer-events-none absolute inset-x-0 top-0 flex h-32 flex-wrap items-start justify-center gap-x-6 gap-y-3 overflow-hidden px-6 pt-4 opacity-70" aria-hidden="true">
    {topParticles.map((i) => (
      <span class="particle-fade rounded-full bg-brand-red" style={`width:${4 + (i % 3) * 3}px;height:${4 + (i % 3) * 3}px;animation-delay:${(i % 8) * 0.3}s;`} />
    ))}
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 flex h-32 flex-wrap items-end justify-center gap-x-6 gap-y-3 overflow-hidden px-6 pb-4 opacity-70" aria-hidden="true">
    {bottomParticles.map((i) => (
      <span class="particle-fade rounded-full bg-brand-yellow" style={`width:${4 + (i % 3) * 3}px;height:${4 + (i % 3) * 3}px;animation-delay:${(i % 8) * 0.3 + 0.2}s;`} />
    ))}
  </div>

    <div class="pointer-events-none absolute -left-16 top-[18%] size-96 rounded-full bg-brand-red/15 blur-[110px] animate-float-slow" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-16 bottom-[15%] size-96 rounded-full bg-brand-yellow/20 blur-[110px] animate-float-slower" aria-hidden="true"></div>

    <div class="pointer-events-none absolute inset-y-0 left-6 hidden flex-col justify-center gap-10 sm:flex lg:left-14" aria-hidden="true">
    {microLabels.slice(0, 3).map((label, i) => <span class="label-slide t-fg-muted font-display text-xs font-bold uppercase tracking-[0.3em]" style={`animation-delay:${i * 0.5}s`}>{label}</span>)}
  </div>
  <div class="pointer-events-none absolute inset-y-0 right-6 hidden flex-col items-end justify-center gap-10 sm:flex lg:right-14" aria-hidden="true">
    {microLabels.slice(3).map((label, i) => <span class="label-slide-reverse t-fg-muted font-display text-xs font-bold uppercase tracking-[0.3em]" style={`animation-delay:${i * 0.5 + 0.25}s`}>{label}</span>)}
  </div>

    <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-2 sm:gap-4" aria-hidden="true">
    <p class="t-outline-text font-wordmark m-0 select-none whitespace-nowrap text-center text-[min(26vh,28vw)] leading-none sm:text-[min(32vh,22vw)] lg:text-[min(36vh,16vw)]">
      B<span id="tex5-i-letter" class="inline-block text-transparent [-webkit-text-stroke:0]">I</span>G
    </p>
    <p class="text-gradient-warm font-wordmark m-0 select-none whitespace-nowrap text-center text-[min(26vh,13vw)] leading-none sm:text-[min(32vh,10vw)] lg:text-[min(36vh,8vw)]">
      TALENT
    </p>
  </div>

    <div id="tex5-bottle-slot" class="absolute z-10">
    <div class="pointer-events-none absolute -inset-x-[150%] -inset-y-[35%] rounded-full bg-[radial-gradient(ellipse_50%_50%_at_50%_50%,rgba(198,24,24,0.28),transparent_72%)]"></div>
    <model-viewer
      id="bottle-viewer-v5"
      src="/models/botella3d.glb"
      poster={botella2d.src}
      alt="Botella BIG Cola en 3D"
      camera-orbit="6deg 78deg 100%"
      field-of-view="26deg"
      exposure="1.15"
      shadow-intensity="0"
      camera-controls
      disable-zoom
      interaction-prompt="none"
      loading="eager"
      reveal="auto"
      class="pointer-events-auto relative h-full w-full cursor-grab active:cursor-grabbing"
      style="--poster-color: transparent; background-color: transparent;"
    >
      <Image slot="poster" src={botella2d} alt="Botella BIG Cola" width={520} height={780} class="mx-auto h-full w-auto object-contain" loading="eager" />
    </model-viewer>
  </div>

  <div class="relative mx-auto flex h-[calc(100svh-6rem)] max-w-7xl flex-col justify-end px-5 pb-10 sm:px-8">
    <div class="relative z-10 flex flex-col items-center gap-5 text-center">
      <p class="t-fg-muted reveal font-display max-w-lg text-lg font-medium sm:text-xl">
        Grandes Marcas, <span class="t-fg font-bold">Grandes Talentos.</span>
      </p>

      <div class="grid w-full max-w-xl gap-3 sm:grid-cols-2">
        <div class="t-card t-border rounded-2xl border p-4 text-left backdrop-blur-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-red">Alcance</p>
          <p class="t-fg-muted mt-1 text-sm">Niveles N1 y N2 evaluados en Crecer y Radar de Talento</p>
        </div>
        <div class="t-card t-border rounded-2xl border p-4 text-left backdrop-blur-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-red">Uso</p>
          <p class="t-fg-muted mt-1 text-sm">Base para evaluación, feedback y desarrollo</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #parallax-layer-5 {
    transition: transform 0.3s ease-out;
    will-change: transform;
  }
  .breathing-glow {
    background: radial-gradient(circle at 50% 50%, rgba(198, 24, 24, 0.12), transparent 60%);
    animation: breathe 6s ease-in-out infinite;
  }
  @keyframes breathe {
    0%,
    100% {
      opacity: 0.5;
      filter: hue-rotate(0deg);
    }
    50% {
      opacity: 1;
      filter: hue-rotate(25deg);
    }
  }
  @keyframes mega-sweep-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .mega-sweep {
    animation: mega-sweep-spin 14s linear infinite;
  }
  @keyframes orbit-spin-fast {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes orbit-spin-fast-reverse {
    to {
      transform: rotate(-360deg);
    }
  }
  .orbit-spin-fast {
    animation: orbit-spin-fast 10s linear infinite;
  }
  .orbit-spin-fast-reverse {
    animation: orbit-spin-fast-reverse 8s linear infinite;
  }
  @keyframes hex-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes hex-spin-reverse {
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes hex-pulse {
    0%,
    100% {
      transform: scale(0.9);
    }
    50% {
      transform: scale(1.12);
    }
  }
  .hex-spin.hex-pulse {
    animation:
      hex-spin 9s linear infinite,
      hex-pulse 3s ease-in-out infinite;
  }
  .hex-spin-reverse.hex-pulse {
    animation:
      hex-spin-reverse 11s linear infinite,
      hex-pulse 3s ease-in-out infinite;
  }
  @keyframes particle-fade {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.4);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }
  .particle-fade {
    animation: particle-fade 2.2s ease-in-out infinite;
  }
  @keyframes label-slide {
    0%,
    100% {
      opacity: 0.35;
      transform: translateX(0);
    }
    50% {
      opacity: 0.9;
      transform: translateX(6px);
    }
  }
  @keyframes label-slide-reverse {
    0%,
    100% {
      opacity: 0.35;
      transform: translateX(0);
    }
    50% {
      opacity: 0.9;
      transform: translateX(-6px);
    }
  }
  .label-slide {
    animation: label-slide 2.8s ease-in-out infinite;
  }
  .label-slide-reverse {
    animation: label-slide-reverse 2.8s ease-in-out infinite;
  }
</style>

<script>
  import '@google/model-viewer';
  import { initBottleSway } from '../../scripts/bottle-sway';
  import { initThemeToggle } from '../../scripts/theme-toggle';

  initThemeToggle('inicio-textura-5');

  const viewer = document.querySelector<HTMLElement>('model-viewer#bottle-viewer-v5');
  if (viewer) {
    initBottleSway(viewer, { amplitude: 22, swaySpeed: 0.0003, defaultPhi: 78, radius: '100%' });
  }

  const section = document.querySelector<HTMLElement>('#inicio-textura-5');
  const iLetter = document.querySelector<HTMLElement>('#tex5-i-letter');
  const slot = document.querySelector<HTMLElement>('#tex5-bottle-slot');

  const positionBottle = () => {
    if (!section || !iLetter || !slot) return;
    const sectionRect = section.getBoundingClientRect();
    const iRect = iLetter.getBoundingClientRect();
    const width = Math.max(iRect.width, 64);
    const centerX = iRect.left + iRect.width / 2;
    slot.style.left = `${centerX - width / 2 - sectionRect.left}px`;
    slot.style.top = `${iRect.top - sectionRect.top}px`;
    slot.style.width = `${width}px`;
    slot.style.height = `${iRect.height}px`;
  };

  positionBottle();
  document.fonts?.ready.then(positionBottle);
  window.addEventListener('resize', positionBottle);

  const parallax = document.querySelector<HTMLElement>('#parallax-layer-5');
  if (section && parallax) {
    section.addEventListener('pointermove', (e) => {
      const rect = section.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      parallax.style.transform = `translate(${x * 22}px, ${y * 16}px)`;
    });
    section.addEventListener('pointerleave', () => {
      parallax.style.transform = 'translate(0, 0)';
    });
  }
</script>
