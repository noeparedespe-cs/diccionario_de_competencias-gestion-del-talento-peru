---
import { Image } from 'astro:assets';
import botella2d from '../../assets/botella2d.png';
import crecerSolid from '../../assets/crecer-solid.png';
import crecerWhite from '../../assets/crecer-white.png';
import radarSolid from '../../assets/radar-de-talento-solid.png';
import radarWhite from '../../assets/radar-de-talento-white.png';
import ThemeToggleButton from './ThemeToggleButton.astro';
---

<section id="inicio-orbitas-logos-a" class="theme noise relative min-h-[100svh] overflow-hidden pt-24" data-theme="dark">
  <ThemeToggleButton />
  <div class="t-grid-lines pointer-events-none absolute inset-0 opacity-100"></div>

    <div class="pointer-events-none absolute -left-[20rem] top-1/2 size-[42rem] -translate-y-1/2 opacity-[0.55]" aria-hidden="true">
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-yellow/70"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-yellow/60"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-yellow/60 [animation-delay:0.8s]"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-yellow/60 [animation-delay:1.6s]"></span>
    <div class="orbit-spin absolute inset-0">
      {[0, 60, 120, 180, 240, 300].map((deg, i) => (
        <span
          class="orbit-dot absolute left-1/2 top-1/2 rounded-full bg-brand-yellow shadow-[0_0_16px_4px_rgba(246,198,18,0.65)]"
          style={`width:${i % 2 === 0 ? '0.85rem' : '0.5rem'};height:${i % 2 === 0 ? '0.85rem' : '0.5rem'};transform: rotate(${deg}deg) translateX(${16 + (i % 3) * 4}rem);`}
        />
      ))}
    </div>
  </div>
    <div class="pointer-events-none absolute -right-[20rem] top-1/2 size-[38rem] -translate-y-1/2 opacity-[0.55]" aria-hidden="true">
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-red/70"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-red/60 [animation-delay:0.4s]"></span>
    <span class="absolute left-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 animate-pulse-ring rounded-full bg-brand-red/60 [animation-delay:1.2s]"></span>
    <div class="orbit-spin-reverse absolute inset-0">
      {[30, 90, 150, 210, 270, 330].map((deg, i) => (
        <span
          class="orbit-dot absolute left-1/2 top-1/2 rounded-full bg-brand-red shadow-[0_0_16px_4px_rgba(198,24,24,0.6)]"
          style={`width:${i % 2 === 0 ? '0.75rem' : '0.45rem'};height:${i % 2 === 0 ? '0.75rem' : '0.45rem'};transform: rotate(${deg}deg) translateX(${14 + (i % 3) * 4}rem);`}
        />
      ))}
    </div>
  </div>

    <div class="pointer-events-none absolute -left-16 bottom-[12%] size-96 rounded-full bg-brand-yellow/20 blur-[110px] animate-float-slower" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-20 top-[15%] size-96 rounded-full bg-brand-red/15 blur-[110px] animate-float-slow" aria-hidden="true"></div>

    <div class="pointer-events-none absolute left-4 top-1/2 hidden w-40 -translate-y-1/2 animate-float-slow sm:block lg:left-10 lg:w-52" aria-hidden="true">
    <Image src={crecerSolid} alt="" width={280} height={90} class="theme-logo-light h-auto w-full object-contain drop-shadow-lg" />
    <Image src={crecerWhite} alt="" width={280} height={90} class="theme-logo-dark h-auto w-full object-contain drop-shadow-lg" />
  </div>
    <div class="pointer-events-none absolute right-4 top-1/2 hidden w-40 -translate-y-1/2 animate-float-slower sm:block lg:right-10 lg:w-52" aria-hidden="true">
    <Image src={radarSolid} alt="" width={280} height={90} class="theme-logo-light h-auto w-full object-contain drop-shadow-lg" />
    <Image src={radarWhite} alt="" width={280} height={90} class="theme-logo-dark h-auto w-full object-contain drop-shadow-lg" />
  </div>

    <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-2 sm:gap-4" aria-hidden="true">
    <p class="t-outline-text font-wordmark m-0 select-none whitespace-nowrap text-center text-[min(26vh,28vw)] leading-none sm:text-[min(32vh,22vw)] lg:text-[min(36vh,16vw)]">
      B<span id="texla-i-letter" class="inline-block text-transparent [-webkit-text-stroke:0]">I</span>G
    </p>
    <p class="text-gradient-warm font-wordmark m-0 select-none whitespace-nowrap text-center text-[min(26vh,13vw)] leading-none sm:text-[min(32vh,10vw)] lg:text-[min(36vh,8vw)]">
      TALENT
    </p>
  </div>

    <div id="texla-bottle-slot" class="absolute z-10">
    <div class="pointer-events-none absolute -inset-x-[150%] -inset-y-[35%] rounded-full bg-[radial-gradient(ellipse_50%_50%_at_50%_50%,rgba(246,198,18,0.25),transparent_72%)]"></div>
    <model-viewer
      id="bottle-viewer-la"
      src="/models/botella3d.glb"
      poster={botella2d.src}
      alt="Botella BIG Cola en 3D"
      camera-orbit="6deg 78deg 100%"
      field-of-view="26deg"
      exposure="1.15"
      shadow-intensity="0"
      camera-controls
      disable-zoom
      interaction-prompt="none"
      loading="eager"
      reveal="auto"
      class="pointer-events-auto relative h-full w-full cursor-grab active:cursor-grabbing"
      style="--poster-color: transparent; background-color: transparent;"
    >
      <Image slot="poster" src={botella2d} alt="Botella BIG Cola" width={520} height={780} class="mx-auto h-full w-auto object-contain" loading="eager" />
    </model-viewer>
  </div>

  <div class="relative mx-auto flex h-[calc(100svh-6rem)] max-w-7xl flex-col justify-end px-5 pb-10 sm:px-8">
    <div class="relative z-10 flex flex-col items-center gap-5 text-center">
      <p class="t-fg-muted reveal font-display max-w-lg text-lg font-medium sm:text-xl">
        Grandes Marcas, <span class="t-fg font-bold">Grandes Talentos.</span>
      </p>

      <div class="grid w-full max-w-xl gap-3 sm:grid-cols-2">
        <div class="t-card t-border rounded-2xl border p-4 text-left backdrop-blur-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-red">Alcance</p>
          <p class="t-fg-muted mt-1 text-sm">Niveles N1 y N2 evaluados en Crecer y Radar de Talento</p>
        </div>
        <div class="t-card t-border rounded-2xl border p-4 text-left backdrop-blur-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-red">Uso</p>
          <p class="t-fg-muted mt-1 text-sm">Base para evaluación, feedback y desarrollo</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes orbit-spin-reverse {
    to {
      transform: rotate(-360deg);
    }
  }
  .orbit-spin {
    animation: orbit-spin 22s linear infinite;
  }
  .orbit-spin-reverse {
    animation: orbit-spin-reverse 18s linear infinite;
  }
  .orbit-dot {
    margin: 0;
    transform-origin: 0 0;
  }
  @keyframes label-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.8;
    }
  }
  .label-pulse {
    animation: label-pulse 3.6s ease-in-out infinite;
  }
</style>

<script>
  import '@google/model-viewer';
  import { initBottleSway } from '../../scripts/bottle-sway';
  import { initThemeToggle } from '../../scripts/theme-toggle';

  initThemeToggle('inicio-orbitas-logos-a');

  const viewer = document.querySelector<HTMLElement>('model-viewer#bottle-viewer-la');
  if (viewer) {
    initBottleSway(viewer, { amplitude: 22, swaySpeed: 0.0003, defaultPhi: 78, radius: '100%' });
  }

  const section = document.querySelector<HTMLElement>('#inicio-orbitas-logos-a');
  const iLetter = document.querySelector<HTMLElement>('#texla-i-letter');
  const slot = document.querySelector<HTMLElement>('#texla-bottle-slot');

  const positionBottle = () => {
    if (!section || !iLetter || !slot) return;
    const sectionRect = section.getBoundingClientRect();
    const iRect = iLetter.getBoundingClientRect();
    const width = Math.max(iRect.width, 64);
    const centerX = iRect.left + iRect.width / 2;
    slot.style.left = `${centerX - width / 2 - sectionRect.left}px`;
    slot.style.top = `${iRect.top - sectionRect.top}px`;
    slot.style.width = `${width}px`;
    slot.style.height = `${iRect.height}px`;
  };

  positionBottle();
  document.fonts?.ready.then(positionBottle);
  window.addEventListener('resize', positionBottle);
</script>
