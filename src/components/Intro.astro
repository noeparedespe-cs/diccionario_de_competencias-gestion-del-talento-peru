---
const pasos = [
  {
    n: '1',
    titulo: 'Evaluar',
    texto: 'Identificar el nivel de desarrollo de cada competencia con base en comportamientos.',
    icon: 'M4 13l4 4L20 5',
  },
  {
    n: '2',
    titulo: 'Retroalimentar',
    texto: 'Dar feedback claro, específico y alineado a expectativas de desempeño.',
    icon: 'M4 4h16v11H7l-3 3V4z',
  },
  {
    n: '3',
    titulo: 'Desarrollar',
    texto: 'Definir acciones concretas para fortalecer las competencias clave.',
    icon: 'M12 4v16m8-8H4',
  },
];
---

<section id="guia" class="relative bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <h2 class="reveal font-display text-4xl font-bold leading-tight text-ink-900 sm:text-5xl">
          ¿Qué es una competencia?
        </h2>

        <blockquote
          class="reveal relative mt-8 rounded-2xl border border-ink-200 bg-ink-100/60 p-7 text-xl font-medium leading-relaxed text-ink-800"
        >
          Una competencia es una habilidad que una persona demuestra en su trabajo a través de sus comportamientos y
          que le permite desempeñarse de manera efectiva en su rol.
          <footer class="mt-4 text-sm font-normal not-italic text-ink-500">— Fuente: Gestión del Talento Perú</footer>
        </blockquote>
      </div>

      <div class="lg:col-span-7">
        <h3 class="reveal font-display text-4xl font-bold leading-tight text-ink-900 sm:text-5xl">
          ¿Cómo usar este diccionario?
        </h3>

        <ol class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-3">
          {
            pasos.map((p, i) => (
              <li class="reveal group relative">
                <div class="flex items-center">
                  <span class="font-display grid size-12 shrink-0 place-items-center rounded-full bg-ink-900 text-lg font-bold text-white transition group-hover:bg-brand-red">
                    {p.n}
                  </span>
                  {i < pasos.length - 1 && <span class="ml-3 hidden h-px flex-1 bg-ink-200 sm:block" />}
                </div>
                <div class="mt-4">
                  <h4 class="font-display flex items-center gap-2 text-xl font-bold text-ink-900">
                    {p.titulo}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-brand-red">
                      <path d={p.icon} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </h4>
                  <p class="mt-1.5 text-ink-500">{p.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
