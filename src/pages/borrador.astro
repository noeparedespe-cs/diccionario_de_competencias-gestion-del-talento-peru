---
import Layout from '../layouts/Layout.astro';
import HeroBottleTexture from '../components/hero-variants/HeroBottleTexture.astro';
import HeroTexturaMirror from '../components/hero-variants/HeroTexturaMirror.astro';
import HeroTexturaAsimetrica from '../components/hero-variants/HeroTexturaAsimetrica.astro';
import HeroTexturaVertical from '../components/hero-variants/HeroTexturaVertical.astro';
import HeroTexturaHiperactiva from '../components/hero-variants/HeroTexturaHiperactiva.astro';
import HeroConstelacion from '../components/hero-variants/HeroConstelacion.astro';
import HeroTipoGigante from '../components/hero-variants/HeroTipoGigante.astro';
import HeroTipoEditorial from '../components/hero-variants/HeroTipoEditorial.astro';
import HeroTipoMixta from '../components/hero-variants/HeroTipoMixta.astro';
import HeroRadarCentral from '../components/hero-variants/HeroRadarCentral.astro';
import HeroMezclaUno from '../components/hero-variants/HeroMezclaUno.astro';
import HeroMezclaDos from '../components/hero-variants/HeroMezclaDos.astro';
import HeroOrbitasLogosA from '../components/hero-variants/HeroOrbitasLogosA.astro';
import HeroOrbitasLogosB from '../components/hero-variants/HeroOrbitasLogosB.astro';

const items: [string, string][] = [
  ['inicio-textura', '1 · Original'],
  ['inicio-textura-2', '2 · Órbitas'],
  ['inicio-textura-3', '3 · Escaneo'],
  ['inicio-textura-4', '4 · Partículas'],
  ['inicio-textura-5', '5 · Hiperactiva'],
  ['inicio-textura-6', '6 · Constelación'],
  ['inicio-tipo-1', '7 · Tipo XXL'],
  ['inicio-tipo-2', '8 · Editorial'],
  ['inicio-tipo-3', '9 · Tipo mixta'],
  ['inicio-radar-central', '10 · Radar central'],
  ['inicio-mezcla-1', '11 · Mezcla (radar dominante)'],
  ['inicio-mezcla-2', '12 · Mezcla (órbitas dominantes)'],
  ['inicio-orbitas-logos-a', '13 · Logos flotantes (ganadora ✓)'],
  ['inicio-orbitas-logos-b', '14 · Logos verticales al borde'],
];
---

<Layout title="Borrador — historial de diseño del Inicio">
  <header class="fixed inset-x-0 top-0 z-50 flex items-center justify-between gap-4 border-b border-white/10 bg-ink-900/90 px-5 py-3 backdrop-blur-md sm:px-8">
    <p class="font-display text-sm font-bold text-white">Borrador — historial de portadas</p>
    <nav class="flex max-w-[70vw] flex-wrap items-center gap-1 overflow-x-auto">
      {
        items.map(([id, label]) => (
          <a href={`#${id}`} class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold text-white/60 transition hover:bg-white/10 hover:text-white">
            {label}
          </a>
        ))
      }
    </nav>
  </header>

  <main>
    <div class="bg-white px-5 pb-10 pt-32 text-center">
      <p class="font-display text-2xl font-bold text-ink-900">Historial de exploración del Inicio</p>
      <p class="mx-auto mt-2 max-w-xl text-ink-500">
        Todas las variantes que se probaron antes de quedarnos con "Logos flotantes" (opción 13), ahora usada en el
        sitio real. Se conservan aquí solo como referencia.
      </p>
    </div>

    {
      (
        [
          ['1 — Original', HeroBottleTexture],
          ['2 — Órbitas', HeroTexturaMirror],
          ['3 — Escaneo', HeroTexturaAsimetrica],
          ['4 — Partículas', HeroTexturaVertical],
          ['5 — Hiperactiva', HeroTexturaHiperactiva],
          ['6 — Constelación', HeroConstelacion],
          ['7 — Tipo XXL', HeroTipoGigante],
          ['8 — Editorial', HeroTipoEditorial],
          ['9 — Tipo mixta', HeroTipoMixta],
          ['10 — Radar central', HeroRadarCentral],
          ['11 — Mezcla (radar dominante)', HeroMezclaUno],
          ['12 — Mezcla (órbitas dominantes)', HeroMezclaDos],
          ['13 — Logos flotantes (ganadora ✓, ahora en el sitio real)', HeroOrbitasLogosA],
          ['14 — Logos verticales al borde', HeroOrbitasLogosB],
        ] as [string, any][]
      ).map(([label, Comp]) => (
        <div class="relative">
          <span class="absolute left-1/2 top-24 z-30 -translate-x-1/2 rounded-full bg-brand-yellow px-4 py-1 text-xs font-bold uppercase tracking-widest text-ink-900">
            {label}
          </span>
          {}
          <Comp />
        </div>
      ))
    }
  </main>
</Layout>
